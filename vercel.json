{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/clients/([^/]+)", "status": 307, "headers": { "Location": "/clients?clientId=$1" } },
    {
      "src": "/agenda/(?<nxtPmonth>[^/]+?)/(?<nxtPid>[^/]+?)(?<rscSuffix>\\.rsc|\\.prefetch\\.rsc|\\.segments/.+\\.segment\\.rsc)(?:/)?",
      "dest": "/frontend/agenda/[month]/[id]$rscSuffix?nxtPmonth=$nxtPmonth&nxtPid=$nxtPid"
    },
    {
      "src": "/agenda/(?<nxtPmonth>[^/]+?)/(?<nxtPid>[^/]+?)(?:/)?",
      "dest": "/frontend/agenda/[month]/[id]?nxtPmonth=$nxtPmonth&nxtPid=$nxtPid"
    },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
